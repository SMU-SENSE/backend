# Google OAuth is required for normal application login.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FRONTEND_BASE_URL=http://localhost:3000

# Docker Compose PostgreSQL initialization.
POSTGRES_DB=malmoa
POSTGRES_USER=malmoa
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

# Spring postgres profile connection.
DB_URL=jdbc:postgresql://localhost:5432/malmoa
DB_USERNAME=malmoa
DB_PASSWORD=replace-with-local-password

SESSION_COOKIE_SECURE=false
SPRINGDOC_ENABLED=true

# Optional: path to a Firebase service account JSON. Leave unset to skip guardian push notifications
# (emergency-symbol alerts are still recorded in guardian_notifications either way).
FIREBASE_CREDENTIALS_PATH=
